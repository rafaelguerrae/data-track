# Produção (VPS). Copie para .env.prod e preencha. Nunca commite o .env.prod.
# Um único hostname atende a API (443) e o MQTT (8883)
DOMAIN=data-track.duckdns.org
# URL do frontend na Vercel (usada no CORS da API)
WEB_ORIGIN=https://data-track.vercel.app

POSTGRES_PASSWORD=troque-esta-senha
MQTT_API_PASSWORD=troque-esta-senha

# Provedor SMTP real (SES, Resend, etc.)
SMTP_HOST=smtp.exemplo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=alertas@exemplo.com
